# Windows scripts must keep CRLF: cmd.exe `goto`/label parsing and `for /f`
# loops are fragile with LF-only files, and Notepad/editors expect CRLF there.
*.bat text eol=crlf
*.cmd text eol=crlf
*.vbs text eol=crlf
*.ps1 text eol=crlf

# Unix scripts must keep LF (CRLF breaks shebang lines).
*.sh text eol=lf
