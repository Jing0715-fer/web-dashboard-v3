generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Device {
  id        String    @id @default(cuid())
  name      String
  ip        String
  port      Int       @default(3100)
  apiKey    String    @unique
  status    String    @default("offline")
  lastSeen  DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
}

model Project {
  id          String        @id @default(cuid())
  deviceId    String?
  name        String
  path        String
  description String        @default("")
  icon        String        @default("folder")
  tags        String        @default("[]")
  // Git repository URL (https://github.com/user/repo) — powers the one-click
  // "Pull latest code" action. Empty string = no repo configured.
  repoUrl     String        @default("")
  // Project notes — used to be localStorage-only (lost when switching
  // browsers/devices); now persisted server-side.
  notes       String        @default("")
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  environments Environment[]
  thumbnails  Thumbnail[]
  device      Device?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([deviceId, path])
  @@index([deviceId])
}

model Environment {
  id        String   @id @default(cuid())
  projectId String
  name      String
  cmd       String
  port      Int
  envVars   String   @default("{}")
  status    String   @default("stopped")
  pid       Int?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// Live-preview thumbnail for a project environment. One row per environment
// (latest capture wins — upserted). Rows are ONLY written after a successful
// headless-browser screenshot, so a row always corresponds to a real JPEG on
// disk under <repo>/db/thumbnails/. `error` records the last failure for
// diagnostics (cleared on the next success) without wiping the last good image.
model Thumbnail {
  id         String   @id @default(cuid())
  projectId  String
  // Environment the screenshot was taken of (denormalized name/port so the
  // card can label the preview without an extra join).
  envId      String   @unique
  envName    String
  port       Int
  // File name inside db/thumbnails/ — also the public URL segment
  // (/api/thumbnails/<file>?v=<capturedAtMs> for cache busting).
  file       String
  bytes      Int      @default(0)
  width      Int      @default(0)
  height     Int      @default(0)
  // Last capture failure reason (null = last attempt succeeded). Kept even
  // when an older image stays on disk so the UI can explain staleness.
  error      String?
  capturedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// Learned repair lesson (v1.24) — "how this environment was last brought back
// to life". Written after EVERY successful repair (deterministic pattern fix,
// lesson replay, legacy LLM loop or delegated CLI round), replayed BEFORE any
// LLM is consulted on the next failure: same error → same fix, instantly,
// without burning a model call. One row per environment (latest wins).
model RepairLesson {
  id          String    @id @default(cuid())
  envId       String    @unique
  projectId   String
  // Canonical signature of the failure this lesson solves (module-missing,
  // cache-corruption, port-mismatch, raw-tail fallback …).
  errorSig    String    @default("")
  diagnosis   String    @default("")
  // JSON array of safe shell commands that were part of the successful fix
  // (e.g. ["bun install"]) — replayed verbatim through the safety gate.
  fixCmds     String    @default("[]")
  // JSON array of build-artifact dirs that were cleaned (e.g. [".next"]).
  cleanTargets String   @default("[]")
  // Working start configuration at success time (null fields = unchanged).
  cmd         String?
  port        Int?
  envVars     String?
  // What produced the fix: 'pattern' | 'lesson' | 'legacy' | 'cli'.
  source      String    @default("legacy")
  useCount    Int       @default(0)
  succeededAt DateTime  @default(now())
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId])
}

model LlmConfig {
  id        String   @id @default("default")
  provider  String   @default("")
  apiKey    String   @default("")
  baseUrl   String   @default("")
  model     String   @default("")
  // Auto-repair engine selection (switchable in the LLM settings dialog):
  //   'legacy' — built-in LLM tool loop (inspect/probe/patch/run_retry, …)
  //   'cli'    — delegate the whole diagnose+fix phase to an installed
  //              agent CLI (Claude Code / Codex / Hermes / …) invoked
  //              headless with an assembled context package; the dashboard
  //              independently health-verifies afterwards and falls back to
  //              legacy when no CLI is found.
  repairMode String   @default("legacy")
  // Which CLI to delegate to: '' = auto-detect (first installed from the
  // priority list), a known id (claude/codex/gemini/opencode/hermes), or
  // 'custom:<template>' where the template must contain {promptFile}
  // (relative) or {promptFileAbs} (absolute) as the task-file placeholder.
  repairCli  String   @default("")
  updatedAt DateTime @updatedAt
}

// Snapshot-style activity feed (no foreign keys — deleting a project keeps
// its history). Written fire-and-forget via src/lib/activity.ts.
model ActivityEvent {
  id          String   @id @default(cuid())
  projectId   String?
  projectName String?
  envId       String?
  envName     String?
  deviceId    String?
  deviceName  String?
  type        String
  message     String
  detail      String?
  level       String   @default("info") // info | success | warn | error
  durationMs  Int?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([projectId, createdAt])
}

// ============ Authentication (Task 11-a) ============

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  passwordHash      String?   // null for Google-only accounts
  role              String    @default("user")     // 'admin' | 'user'
  status            String    @default("pending")  // 'pending' | 'approved' | 'rejected'
  provider          String    @default("credentials") // 'credentials' | 'google'
  googleId          String?   @unique
  avatarUrl         String?
  rejectionReason   String?
  passwordChangedAt DateTime?
  lastLoginAt       DateTime?
  approvedAt        DateTime?
  approvedById      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  sessions          Session[]

  @@index([status])
}

// Revocable server-side session records (Task 19). One row per issued
// dash_session token, keyed by the SHA-256 hash of the token so raw
// credentials never touch the database. Deleting a user cascades.
model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  ip         String?
  userAgent  String?
  remember   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Key/value settings store (auth secret, Google OAuth credentials, …).
// `value` is always a JSON string.
model AppSetting {
  key       String   @id
  value     String   // JSON string
  updatedAt DateTime @updatedAt
}
