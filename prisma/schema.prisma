generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Device {
  id        String    @id @default(cuid())
  name      String
  ip        String
  port      Int       @default(3100)
  apiKey    String    @unique
  status    String    @default("offline")
  lastSeen  DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
}

model Project {
  id          String        @id @default(cuid())
  deviceId    String?
  name        String
  path        String
  description String        @default("")
  icon        String        @default("folder")
  tags        String        @default("[]")
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  environments Environment[]
  device      Device?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([deviceId, path])
  @@index([deviceId])
}

model Environment {
  id        String   @id @default(cuid())
  projectId String
  name      String
  cmd       String
  port      Int
  envVars   String   @default("{}")
  status    String   @default("stopped")
  pid       Int?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model LlmConfig {
  id        String   @id @default("default")
  provider  String   @default("")
  apiKey    String   @default("")
  baseUrl   String   @default("")
  model     String   @default("")
  updatedAt DateTime @updatedAt
}

// Snapshot-style activity feed (no foreign keys — deleting a project keeps
// its history). Written fire-and-forget via src/lib/activity.ts.
model ActivityEvent {
  id          String   @id @default(cuid())
  projectId   String?
  projectName String?
  envId       String?
  envName     String?
  deviceId    String?
  deviceName  String?
  type        String
  message     String
  detail      String?
  level       String   @default("info") // info | success | warn | error
  durationMs  Int?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([projectId, createdAt])
}

// ============ Authentication (Task 11-a) ============

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  passwordHash      String?   // null for Google-only accounts
  role              String    @default("user")     // 'admin' | 'user'
  status            String    @default("pending")  // 'pending' | 'approved' | 'rejected'
  provider          String    @default("credentials") // 'credentials' | 'google'
  googleId          String?   @unique
  avatarUrl         String?
  rejectionReason   String?
  passwordChangedAt DateTime?
  lastLoginAt       DateTime?
  approvedAt        DateTime?
  approvedById      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  sessions          Session[]

  @@index([status])
}

// Revocable server-side session records (Task 19). One row per issued
// dash_session token, keyed by the SHA-256 hash of the token so raw
// credentials never touch the database. Deleting a user cascades.
model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  ip         String?
  userAgent  String?
  remember   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Key/value settings store (auth secret, Google OAuth credentials, …).
// `value` is always a JSON string.
model AppSetting {
  key       String   @id
  value     String   // JSON string
  updatedAt DateTime @updatedAt
}
